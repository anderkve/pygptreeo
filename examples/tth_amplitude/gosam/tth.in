# GoSam settings for the one-loop ttH test functions
form.bin=/usr/bin/tform
form.threads=2
form.tempdir=/tmp
qgraf.bin=<path to qgraf>
fc.bin=gfortran
reduction_programs=ninja,golem95
model.options=Nfgen:1, masses: mT mH, widths: none
filter.nlo=lambda d: not d.isScaleless()
PSP_check=True
PSP_rescue=True
PSP_verbosity=False
